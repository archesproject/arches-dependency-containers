# arches-docker dev env: PG16+ES8 from arches-shared-containers/arches.
# Copy to arches-docker's scaffold/templates/.runtime/development/env_file.76.env
# (or $ARCHES_DEV_ENV_DIR), fill in ARCHES_ESPASSWORD, then: init-project.sh --dev 76 ...

# Docker network of the shared stack
DOCKER_NETWORK=arches-dev

# Arches project settings
ARCHES_PROJECT=@@PROJECT_NAME@@
INSTALL_DEFAULT_GRAPHS=False
INSTALL_DEFAULT_CONCEPTS=False

# Database connection
PGUSERNAME=postgres
PGPASSWORD=postgis
PGDBNAME=@@PROJECT_PACKAGE@@
PGHOST=arches-postgres16
PGPORT=5432

# Elasticsearch connection (ARCHES_ESPASSWORD = ELASTIC_PASSWORD in arches/.env)
ARCHES_ESHOST=arches-elasticsearch8
ARCHES_ESPORT=9200
ARCHES_ESPASSWORD=
ARCHES_ES_INDEX_PREFIX=@@PROJECT_PACKAGE@@

# Celery broker (project-local RabbitMQ)
ARCHES_CELERY_BROKER_URL=amqp://arches:arches@rabbitmq:5672/

# Django settings
DJANGO_MODE=DEV
DJANGO_DEBUG=True
ARCHES_DJANGO_DEBUG=True
DOMAIN_NAMES=*
DJANGO_PORT=80
PYTHONUNBUFFERED=0
TZ=PST
ARCHES_PUBLIC_SERVER_ADDRESS=http://localhost/

# Uncomment the following line to enable the one-shot webpack development build
#ARCHES_WEBPACK_BUILD_MODE=1
